{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../types/*"],
      "@shared-lib/*": ["../lib/*"],
      "@/*": ["../*"]
    }
  },
  "include": ["src/**/*", "../types/**/*", "../lib/scoring.ts"],
  "exclude": ["node_modules", "dist"]
}
